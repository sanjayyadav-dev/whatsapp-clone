<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="WhatsAppClone.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:WhatsAppClone.Mobile.Views"
       xmlns:local="clr-namespace:WhatsAppClone.Mobile"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />
</Shell>