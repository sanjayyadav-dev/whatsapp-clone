<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="WhatsAppClone.Mobile.Views.ProfileSetupPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WhatsAppClone.Mobile.ViewModels"
             x:DataType="vm:ProfileSetupViewModel"
             Title="Profile"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Set up your profile" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry Text="{Binding DisplayName}" Placeholder="Your name" MaxLength="100" />
        <Entry Text="{Binding About}" Placeholder="About" MaxLength="200" />
        <Label Text="{Binding Error}" TextColor="Red" />
        <Button Text="Continue" Command="{Binding SaveCommand}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
</ContentPage>