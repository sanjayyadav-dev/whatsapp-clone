<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="WhatsAppClone.Mobile.Views.OtpPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WhatsAppClone.Mobile.ViewModels"
             x:DataType="vm:OtpViewModel"
             Title="Verify">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="{Binding Phone, StringFormat='OTP sent to {0}'}" HorizontalOptions="Center" />
        <Entry Text="{Binding Otp}" Placeholder="6 digit OTP" Keyboard="Numeric" MaxLength="6" HorizontalTextAlignment="Center" />
        <Label Text="{Binding Error}" TextColor="Red" />
        <Button Text="Verify" Command="{Binding VerifyCommand}" />
        <Button Text="Resend OTP" Command="{Binding ResendCommand}" BackgroundColor="Transparent" TextColor="Gray" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
</ContentPage>